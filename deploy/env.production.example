# Copy to  backend/.env  on the server and fill in real values.
# In production the app FAILS TO BOOT unless SECRET_KEY, CORS_ORIGINS and a
# non-SQLite DATABASE_URL are all set (these guards are intentional).

ENVIRONMENT=production

# PostgreSQL from Plesk (Databases → Add Database → PostgreSQL). Plesk shows host,
# db, user, password. A bare postgres:// URL is auto-normalised by the app.
DATABASE_URL=postgresql+psycopg2://creatorhub:CHANGE_ME@127.0.0.1:5432/creatorhub

# Sign-in token secret — generate once, keep stable:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_to_a_long_random_string

# Exact public origin(s) of the app, comma-separated. NOT "*".
CORS_ORIGINS=https://app.yourdomain.com

# Optional
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# ADMIN_EMAIL_DOMAINS=wkwkp.com
# SENTRY_DSN=
# LOG_LEVEL=INFO
