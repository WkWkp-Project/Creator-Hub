# Copy to backend/.env for local runs, or set these as env vars in your host.

# --- Environment ---
# "development" (default) or "production".
# In production the app refuses to start with a default SECRET_KEY or CORS=*.
ENVIRONMENT=development

# --- Security (REQUIRED in production) ---
# Signs login tokens. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-creatorhub-secret-change-me
# How long a login stays valid (hours).
TOKEN_TTL_HOURS=168

# --- Database ---
# SQLite default — zero setup for dev. Use Postgres for production.
DATABASE_URL=sqlite:///./creatorhub.db
# DATABASE_URL=postgresql+psycopg2://creatorhub:STRONGPASS@db:5432/creatorhub

# --- CORS ---
# "*" is fine for local dev. In production set your exact frontend origin(s),
# comma-separated, e.g. https://app.yourdomain.com
CORS_ORIGINS=*

# --- Uploads ---
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls
