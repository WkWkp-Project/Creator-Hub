{
  "name": "creator-hub-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind build for the Creator Hub UI (purged + minified, no CDN at runtime).",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/container-queries": "^0.1.1"
  }
}
